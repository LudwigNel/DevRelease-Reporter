<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevReleaseReporter.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="DevReleaseReporter.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource PageBackgroundBrush}"
        Title="DevRelease Reporter">

    <Window.Styles>
        <Style Selector="TextBlock.form-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16" IsEnabled="{Binding IsIdle}">
                <Border Grid.Row="0" Padding="24" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Translate Azure DevOps activity into a business-friendly release report." FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                            <TextBlock Classes="form-label" Text="Theme"/>
                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      MinWidth="140"/>
                            <TextBlock Text="{Binding LastActivityText}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Release scope" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="Profile"/>
                                <ComboBox ItemsSource="{Binding ProfileOptions}"
                                          SelectedItem="{Binding SelectedProfileName}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding ProfileNameInput}" PlaceholderText="Profile name" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding SaveProfileCommand}" Content="Save profile"/>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding DeleteProfileCommand}" Content="Delete"/>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="Azure DevOps URL"/>
                                <TextBox Text="{Binding OrganizationUrl}" PlaceholderText="https://dev.azure.com/your-org"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="Project name"/>
                                <TextBox Text="{Binding ProjectName}" PlaceholderText="YourProject"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="Repository"/>
                                <TextBox Text="{Binding RepositoryName}" PlaceholderText="YourRepository"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="Branch (optional)"/>
                                <TextBox Text="{Binding BranchName}" PlaceholderText="Leave blank to use all branches"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="Contributor (optional)"/>
                                <ComboBox ItemsSource="{Binding AvailableContributors}"
                                          SelectedItem="{Binding SelectedContributor}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="form-label" Text="From date"/>
                                    <TextBox Text="{Binding FromDate}" PlaceholderText="yyyy-MM-dd"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Classes="form-label" Text="To date"/>
                                    <TextBox Text="{Binding ToDate}" PlaceholderText="yyyy-MM-dd"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="PAT token"/>
                                <TextBox Text="{Binding PersonalAccessToken}" PasswordChar="●" PlaceholderText="Personal access token"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="form-label" Text="Output HTML path"/>
                                <TextBox Text="{Binding OutputPath}" PlaceholderText="C:\Reports\release-report.html"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding IncludeWorkItems}" Content="Include linked work items"/>
                            <CheckBox IsChecked="{Binding IncludeTechnicalAppendix}" Content="Include technical appendix"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                            <StackPanel Grid.Row="0" Spacing="4">
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding PreviewSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FetchSummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                                <Border Grid.Row="0" Grid.Column="0" Padding="16" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding StatOneLabel}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding StatOneValue}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Padding="16" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding StatTwoLabel}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding StatTwoValue}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Padding="16" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding StatThreeLabel}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding StatThreeValue}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Padding="16" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding StatFourLabel}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding StatFourValue}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="Narrative preview" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBox Grid.Row="3"
                                     Text="{Binding PreviewText}"
                                     Background="{DynamicResource SurfaceAltBrush}"
                                     BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Classes="primary" Command="{Binding FetchDataCommand}" Content="{Binding FetchButtonText}" MinWidth="120"/>
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding GenerateReportCommand}" Content="{Binding GenerateButtonText}" MinWidth="140"/>
                        <Button Grid.Column="2" Classes="secondary" Command="{Binding ExportHtmlCommand}" Content="{Binding ExportButtonText}" MinWidth="140"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding StatusMessage}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border IsVisible="{Binding IsBusy}"
                Background="{DynamicResource OverlayBrush}">
            <Border Width="420"
                    Padding="24"
                    CornerRadius="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BusyDetail}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="8"/>
                    <TextBlock Text="Please wait while DevRelease Reporter completes the current step." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
